{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true,
    "skipLibCheck": true, "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["vite/client"],
    "baseUrl": ".", "paths": { "@shared/*": ["src/shared/*"] }
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/demo/**/*"],
  "exclude": ["src/shared/**/*.node.ts", "src/shared/**/*.test.ts", "src/demo/compile/**/*", "src/demo/**/*.test.ts"]
}
