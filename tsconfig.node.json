{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "types": ["node"], "baseUrl": ".",
    "paths": { "@shared/*": ["src/shared/*"] }
  },
  "include": ["src/main/**/*", "src/daemon/**/*", "src/preload/**/*", "src/shared/**/*", "src/demo/compile/**/*", "src/demo/**/*.test.ts", "tests/**/*", "electron.vite.config.ts", "vite.demo.config.ts", "electron.vite.daemon.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
