---
import { bento } from '../content/features';
import Icon from './Icon.astro';
// "And more" on /features: the smaller things as a two-column list in the
// articles' column, hairlines between the cells.
---
<section class="extra" id="more">
  <div class="head" data-reveal>
    <p class="eyebrow">And more</p>
    <h2>Small things that add up.</h2>
  </div>
  <ul class="bento" data-reveal>
    {bento.map((b) => <li><span class="icon"><Icon name={b.icon} size={18} /></span><span class="words"><strong>{b.title}</strong><span class="t">{b.text}</span></span></li>)}
  </ul>
</section>
<style>
  .extra { padding: 40px 0 48px; border-top: 1px solid var(--line-soft); scroll-margin-top: -20px; }
  .head { display: flex; flex-direction: column; gap: 6px; margin-bottom: 24px; }
  h2 { font-size: 28px; font-weight: 700; letter-spacing: -.025em; line-height: 1.15; }
  .bento { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--line-soft);
    border: 1px solid var(--line-soft); border-radius: var(--r-lg); overflow: hidden; }
  li { display: flex; gap: 14px; align-items: flex-start; padding: 16px 18px; background: var(--bg-1); transition: background-color var(--t-fast) var(--ease); }
  li:hover { background: var(--bg-2); }
  .icon { flex: none; width: 32px; height: 32px; display: grid; place-items: center; border-radius: var(--radius); background: var(--tint-violet); color: var(--text); box-shadow: inset 0 0 0 1px var(--edge-violet-soft); }
  .words { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  strong { font-weight: 600; font-size: 15px; }
  .t { color: var(--text-3); font-size: 14px; line-height: 1.5; }
  @media (max-width: 860px) { .bento { grid-template-columns: minmax(0, 1fr); } }
</style>
