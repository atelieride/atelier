---
import { keys } from '../content/features';
// "Keyboard first." on /features: the keys in three columns inside the
// articles' column (no full-width band any more; the id stays, old links land here).
---
<section class="extra" id="shortcuts">
  <div class="head" data-reveal>
    <p class="eyebrow">Shortcuts</p>
    <h2>Keyboard first.</h2>
  </div>
  <ul class="keyband" data-reveal>
    {keys.map((k) => <li><span class="caps">{k.keys.map((c) => <kbd class:list={{ sym: /^[⌘⌥⇧⌃]$/.test(c) }}>{c}</kbd>)}</span><span>{k.label}</span></li>)}
  </ul>
</section>
<style>
  .extra { padding: 40px 0 48px; border-top: 1px solid var(--line-soft); scroll-margin-top: -20px; }
  .head { display: flex; flex-direction: column; gap: 6px; margin-bottom: 24px; }
  h2 { font-size: 28px; font-weight: 700; letter-spacing: -.025em; line-height: 1.15; }
  .keyband { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px 24px; }
  li { display: flex; align-items: center; gap: 12px; min-width: 0; color: var(--text-2); font-size: 14.5px; }
  .caps { display: flex; gap: 4px; flex: none; }
  kbd { min-width: 26px; text-align: center; }
  /* ⌘ ⌥ ⇧ ⌃ are outside the bundled fonts' subsets: the system font draws them, a size up to match the letters. */
  kbd.sym { font-family: system-ui, var(--mono); font-size: 13px; }
  @media (max-width: 1000px) { .keyband { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .keyband { grid-template-columns: minmax(0, 1fr); } }
</style>
