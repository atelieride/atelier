---
import mark from '../../../assets/brand/mark.svg?url';
import md from '../../../CHANGELOG.md?raw';
import { parseChangelog } from '../lib/changelog';
import { activePage, pathSegment, type PageId } from '../lib/header';
import DownloadButton from './DownloadButton.astro';
import { REPO_URL } from '../lib/repo';
// The header in one row, as a path: the
// mark and the address as a path, `~/useatelier.dev` then the page's own segment, a caret that blinks a few times on
// the home; the pages in mono; ⌘K search; Download. Merged with the page at the top: no fill and no line until the page
// scrolls (scripts/nav.ts › is-scrolled).
const here = Astro.url.pathname;
const current = activePage(here);
const segment = pathSegment(here);
const home = segment === null && !/\/404(\.html)?$/.test(here);
const latest = parseChangelog(md)[0]?.version ?? '';
const links: { id: PageId; href: string }[] = [{ id: 'features', href: '/features' }, { id: 'changelog', href: '/changelog' }];
---
<header class="appbar" data-latest={latest}>
  <a class="home" href="/" aria-label="Atelier, home">
    <img src={mark} width="22" height="22" alt="" />
    <span class="path">~<span class="host">/useatelier.dev</span>{segment && <span class="seg"><span class="slash">/</span>{segment}</span>}{home && <span class="caret" aria-hidden="true"></span>}</span>
  </a>
  <span class="grow"></span>
  <nav aria-label="Main">
    {links.map((l) => (
      <a class="ml" href={l.href} data-page={l.id} aria-current={l.id === current ? 'page' : undefined}>{l.id}{l.id === 'changelog' && <span class="dot" title="New since your last visit" hidden></span>}</a>
    ))}
    <a class="ml ext" href={REPO_URL} title="The code, on GitHub (MIT)">github<span class="arr" aria-hidden="true">↗</span></a>
  </nav>
  <button class="search" type="button" aria-haspopup="dialog" aria-keyshortcuts="Meta+K Control+K /">
    <svg class="lens" width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="9" r="6" /><path d="M13.5 13.5 17 17" /></svg>
    <span class="sr">Search</span><kbd class="kbd" aria-hidden="true">⌘K</kbd><span class="label" aria-hidden="true">search</span>
  </button>
  <div class="cta"><DownloadButton size="sm" /></div>
</header>

<dialog class="search-sheet" aria-label="Search the site">
  <div class="sheet">
    <div class="sheet-field">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="9" r="6" /><path d="M13.5 13.5 17 17" /></svg>
      <input type="text" role="combobox" aria-expanded="true" aria-controls="sheet-list" aria-autocomplete="list" aria-label="Search features, changes, shortcuts" placeholder="Search features, changes, shortcuts…" autocomplete="off" spellcheck="false" />
      <kbd class="kbd">esc</kbd>
    </div>
    <div class="sheet-list" id="sheet-list" role="listbox" aria-label="Results"></div>
    <div class="sheet-note"></div>
    <p class="sheet-status sr" role="status"></p>
    <div class="sheet-foot" aria-hidden="true"><span><kbd class="kbd">↑↓</kbd>move</span><span><kbd class="kbd">↵</kbd>open</span><span><kbd class="kbd">esc</kbd>close</span></div>
  </div>
</dialog>

<script src="../scripts/nav.ts"></script>

<style>
  /* One row, overlapping the page by its height (site.css: main's padding, the hero pulled up), so the hero's glow runs
     under it. At the top it has no fill and no line; once the page scrolls, the frosted fill and the hairline fade in. */
  .appbar { position: sticky; top: 0; z-index: 20; height: var(--appbar-h); margin-bottom: calc(-1 * var(--appbar-h));
    display: flex; align-items: center; gap: 12px; padding: 0 24px; font-size: 13px;
    background: transparent; border-bottom: 1px solid transparent;
    /* Also the live demo's: the header leaves upwards while the demo is open (styles/live-demo.css). */
    transition: background-color var(--t-med) var(--ease), border-color var(--t-med) var(--ease), backdrop-filter var(--t-med) var(--ease),
      transform var(--t-slow) var(--ease), opacity var(--t-slow) var(--ease), visibility 0s; }
  /* The prefixed form first: the CSS minifier keeps only the last of the two, and Chromium reads the unprefixed one. */
  .appbar.is-scrolled { background: var(--bar-fill-strong); border-bottom-color: var(--line-soft);
    -webkit-backdrop-filter: blur(18px) saturate(150%); backdrop-filter: blur(18px) saturate(150%); }

  .home { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 4px 6px 4px 2px; margin-left: -2px; border-radius: var(--r-sm); }
  .home img { flex: none; }
  .home:focus-visible { border-radius: var(--r-sm); }
  .path { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 500 14px var(--mono); color: var(--text-3); transition: color var(--t-fast) var(--ease); }
  .home:hover .path { color: var(--text); }
  .seg { color: var(--text); }
  .slash { color: var(--text-4); }
  /* The home's caret: it blinks five times, then rests (a terminal waiting, not a cursor nagging). */
  .caret { display: inline-block; width: 8px; height: 17px; margin-left: 5px; vertical-align: -3px; border-radius: 1px; background: var(--violet-soft); animation: caret-blink 1.1s steps(1) 5; }
  @keyframes caret-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .caret { animation: none; } }
  .grow { flex: 1; }

  nav { display: flex; gap: 2px; }
  .ml { position: relative; padding: 7px 10px; border-radius: 8px; font: 500 13.5px var(--mono); color: var(--text-3); white-space: nowrap;
    transition: color var(--t-fast) var(--ease), background-color var(--t-fast) var(--ease); }
  .ml:hover { color: var(--text); background: var(--bg-hover); }
  .ml[aria-current] { color: var(--text); text-decoration: underline; text-decoration-color: var(--brand); text-decoration-thickness: 2px; text-underline-offset: 9px; }
  .ml:focus-visible { border-radius: 8px; }
  /* The one link that leaves the site: an arrow that leans out on hover. */
  .ext .arr { display: inline-block; margin-left: 2px; color: var(--text-4); transition: transform var(--t-fast) var(--ease), color var(--t-fast) var(--ease); }
  .ext:hover .arr { color: var(--violet-soft); transform: translate(1.5px, -1.5px); }
  /* The Changelog dot: a version out since the last visit (nav.ts). */
  .dot { position: absolute; top: 5px; right: 3px; width: 6px; height: 6px; border-radius: 50%; background: var(--done); box-shadow: 0 0 0 2px var(--bg-0); }

  .search { display: flex; align-items: center; gap: 8px; height: 32px; margin-left: 6px; padding: 0 11px 0 8px; border-radius: var(--radius);
    background: var(--bg-control); border: 1px solid var(--line); color: var(--text-3); cursor: pointer;
    transition: background-color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease); }
  .search:hover { background: var(--bg-3); border-color: var(--line-strong); color: var(--text-2); }
  .search:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--bg-0), 0 0 0 3.5px var(--violet); }
  .search .lens { display: none; flex: none; }
  .label { font: 500 13px var(--mono); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .kbd { flex: none; font: 500 11px var(--mono); padding: 1px 6px; border-radius: 6px; border: 1px solid var(--line-strong); color: var(--text-3); }
  .cta { display: flex; }

  /* A phone: the path shrinks to ~ and the page, the search to its lens; Download leaves (the hero and the closing
     carry it). */
  @media (max-width: 640px) {
    .appbar { gap: 6px; padding: 0 16px; }
    .home { gap: 8px; }
    .host, .cta, .search .kbd, .search .label { display: none; }
    .path { font-size: 13px; }
    .ml { padding: 6px 6px; font-size: 12.5px; }
    .search { width: 32px; padding: 0; margin-left: 2px; justify-content: center; }
    .search .lens { display: block; }
  }
</style>

<style is:global>
  /* The search sheet: the app's palette (layout.css › palette). Global: nav.ts builds the rows. */
  dialog.search-sheet { width: min(640px, calc(100vw - 32px)); max-width: none; max-height: none; margin: 72px auto auto; padding: 0; border: 0; background: transparent; color: var(--text); overflow: visible; }
  dialog.search-sheet::backdrop { background: var(--sheet-backdrop); backdrop-filter: blur(2px); }
  dialog.search-sheet[open]::backdrop { animation: atl-fade var(--t-med) var(--ease) both; }
  dialog.search-sheet[open] .sheet { animation: atl-pop var(--t-med) var(--ease) both; }
  .sheet { display: flex; flex-direction: column; max-height: min(480px, calc(100dvh - 104px)); border-radius: var(--r-lg); background: var(--bg-float); backdrop-filter: blur(24px) saturate(150%);    border: 1px solid var(--line-strong); box-shadow: var(--shadow-float); overflow: hidden; font-size: 13.5px; }
  .sheet .kbd { flex: none; font: 10.5px var(--mono); padding: 1px 6px; border-radius: 5px; border: 1px solid var(--line-strong); color: var(--text-3); background: var(--bg-control); }
  .sheet-field { display: flex; align-items: center; gap: 10px; padding: 0 14px 0 16px; border-bottom: 1px solid var(--line); color: var(--text-4); }
  /* 16 px: iOS zooms the page into any smaller field it focuses. */
  .sheet-field input { flex: 1; min-width: 0; height: 48px; background: none; border: 0; color: var(--text); font: 16px var(--font); outline: none; }
  .sheet-field input::placeholder { color: var(--text-4); }
  /* As in the app's palette: the open sheet is the focus indicator, not a ring around its field. */
  .sheet-field input:focus-visible { box-shadow: none; }
  .sheet-list { flex: 1; min-height: 0; overflow: auto; padding: 6px; scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
  .sheet-section { padding: 10px 10px 4px; font-size: 10.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--text-4); }
  .sheet-item { display: flex; align-items: center; gap: 10px; height: 34px; padding: 0 10px; border-radius: var(--radius); color: var(--text-2); cursor: pointer; }
  .sheet-item[aria-selected="true"] { background: var(--bg-sel); color: var(--text); box-shadow: inset 0 0 0 1px var(--edge-violet-soft); }
  .sheet-label { flex: 0 1 auto; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sheet-hint { flex: 1; min-width: 0; text-align: right; font-size: 12px; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sheet-hint.is-version { font: 11.5px var(--mono); }
  .sheet-hint.is-love { font: 11.5px var(--mono); color: color-mix(in srgb, var(--pink) 75%, var(--text-3)); }
  .sheet-item mark { background: none; color: var(--text); font-weight: 700; text-decoration: underline; text-decoration-color: var(--edge-violet); text-underline-offset: 3px; }
  .sheet-glyph { flex: none; width: 18px; height: 18px; border-radius: 5px; display: grid; place-items: center; background: var(--bg-3); color: var(--text-3); font: 600 10px var(--mono); }
  .sheet-glyph.is-feature { background: var(--tint-violet); color: var(--violet); }
  .sheet-glyph.is-heart { background: var(--brand); color: var(--on-brand); }
  .sheet-glyph.is-github { background: var(--bg-3); color: var(--text); box-shadow: 0 0 0 1px var(--line-strong); }
  .sheet-item.is-support[aria-selected="true"] { background: var(--tint-pink); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--pink) 35%, transparent); }
  .sheet-glyph.is-new { background: var(--tint-done); color: var(--done); }
  .sheet-glyph.is-page { font: 700 9.5px var(--font); color: var(--text); background: color-mix(in srgb, var(--ring) 14%, var(--bg-3)); box-shadow: 0 0 0 1.5px color-mix(in srgb, var(--ring) 70%, transparent); }
  .sheet-caps { flex: none; margin-left: auto; display: flex; gap: 4px; }
  .sheet-empty { padding: 28px 16px 30px; text-align: center; color: var(--text-3); display: flex; flex-direction: column; gap: 4px; }
  .sheet-empty b { color: var(--text); font-weight: 600; }
  .sheet-foot { display: flex; gap: 16px; padding: 8px 14px; border-top: 1px solid var(--line); font: 11px var(--mono); color: var(--text-4); }
  .sheet-foot span { display: inline-flex; align-items: center; gap: 6px; }
  @media (max-width: 640px) { .sheet-foot { display: none; } .sheet-hint:not(.is-version) { display: none; } }
</style>
