---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { rows, tiles } from '../content/features';
// "The rest of your work, beside the session": eight tiles, each a link to its
// row on /features. A tile's picture is a window onto the row's shot drawn 1:1, never shrunk: object-fit none draws the
// image at its own size (the srcset density makes that 640 CSS px, the shot's size in a 640 px column), and the tile's
// focus point (object-position) picks the part that tells the feature. The files are the ones Window makes for a
// 640 px column (same widths, formats and quality), so /features finds them in the cache. The alt is empty: the
// tile's title names it.
const WIDTH = 640;
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.png', { eager: true });
const items = await Promise.all(tiles.map(async (t) => {
  const row = rows.find((r) => r.id === t.id)!;
  const src = shots[`../assets/shots/${row.shot}.png`]!.default;
  const widths = [...new Set([WIDTH, WIDTH * 2].map((w) => Math.min(w, src.width)))];
  const [avif, webp] = await Promise.all((['avif', 'webp'] as const).map((format) => getImage({ src, format, quality: 90, widths })));
  return { ...t, src, avif: avif!, webp: webp! };
}));
const sizes = `${WIDTH}px`;
---
<div class="block tiles-block">
  <section class="container section beside">
    <div class="head" data-reveal>
      <h2 class="h2">The rest of your work,<br /><span class="dim">beside the session.</span></h2>
      <p class="lead">Files, changes, terminals and the services your project runs. Each one opens as a tab next to your sessions.</p>
    </div>
    <ul class="tiles">
      {items.map((t) => (
        <li>
          <a class="tile" href={`/features#${t.id}`} data-tile={t.id} data-reveal>
            <span class="pic">
              <picture>
                <source type="image/avif" srcset={t.avif.srcSet.attribute} sizes={sizes} />
                <img src={t.webp.src} srcset={t.webp.srcSet.attribute} sizes={sizes} alt="" width={t.src.width} height={t.src.height} loading="lazy" decoding="async" style={`object-position: ${t.focus}`} />
              </picture>
            </span>
            <span class="words"><strong>{t.title}</strong><span>{t.text}</span></span>
          </a>
        </li>
      ))}
    </ul>
    <div class="more" data-reveal>
      <p>Also: background agents and shells · scheduled prompts · Claude accounts · ports · service logs</p>
      <a class="all" href="/features">All features<span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</div>
<style>
  /* Rendered only near the screen: until then its eight pictures (whole shots, for the 1:1 windows) are not fetched,
     so the home's first load carries the hero and the two blocks above, not the tiles. Laid out off screen only, so
     nothing visible moves when it renders; `auto` keeps the size it had once rendered. */
  .tiles-block { content-visibility: auto; contain-intrinsic-size: auto 1100px; }
  .beside { display: flex; flex-direction: column; gap: 48px; }
  .head { display: flex; flex-direction: column; gap: 20px; max-width: 680px; }
  .h2 { text-wrap: balance; }
  .tiles { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .tiles li { display: flex; min-width: 0; }
  .tile { flex: 1; display: flex; flex-direction: column; gap: 14px; min-width: 0; padding: 10px 10px 18px; border-radius: var(--r-lg);
    background: var(--bg-1); border: 1px solid var(--line-soft);
    transition: border-color var(--t-fast) var(--ease), background-color var(--t-fast) var(--ease); }
  .tile:hover { border-color: var(--edge-violet-soft); background: var(--bg-2); }
  .tile:focus-visible { border-radius: var(--r-lg); border-color: var(--edge-violet-soft); }
  .pic { display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--r-sm); background: var(--bg-2); box-shadow: inset 0 0 0 1px var(--line-soft); }
  .pic picture { display: contents; }
  /* The shot at its own size (1:1), the tile a window onto it: never max-width'd down to the tile. */
  .pic img { width: 100%; height: 100%; max-width: none; object-fit: none; }
  .words { display: flex; flex-direction: column; gap: 4px; padding: 0 6px; }
  .words strong { font-weight: 600; font-size: 15.5px; }
  .words span { color: var(--text-3); font-size: 14px; line-height: 1.5; }
  .more { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; padding-top: 4px; }
  .more p { color: var(--text-3); font-size: 14.5px; }
  .all { display: inline-flex; align-items: center; gap: 8px; color: var(--text-2); font-size: 15px; font-weight: 500; transition: color var(--t-fast) var(--ease); }
  .all .arrow { transition: transform var(--t-fast) var(--ease); }
  .all:hover { color: var(--text); }
  .all:hover .arrow { transform: translateX(2px); }
  @media (max-width: 1000px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .tiles { grid-template-columns: minmax(0, 1fr); } }
</style>
