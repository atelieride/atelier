---
import '../styles/site.css';
import sans from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import sansExt from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-ext-wght-normal.woff2?url';
import mono from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import monoExt from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-ext-wght-normal.woff2?url';
import mark from '../../../assets/brand/mark.svg?url';
import { config } from '../config';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SupportToast from '../components/SupportToast.astro';
import { beaconTag } from '../lib/analytics';
import { jsonLdScript } from '../lib/seo';
// `path: null`: not a real page (404): never indexed, no canonical URL.
// `jsonLd`: structured data for search engines.
interface Props { title: string; description: string; path: string | null; jsonLd?: Record<string, unknown> }
const { title, description, path, jsonLd } = Astro.props;
const canonical = path === null ? null : new URL(path, config.siteUrl).href;
const noindex = !config.launched || path === null;
const og = new URL('/og.png', config.siteUrl).href;
// Production builds only; e2e builds set SITE_NO_BEACON=1 so test runs never report visits.
const beacon = beaconTag(config.webAnalyticsToken, import.meta.env.PROD && process.env.SITE_NO_BEACON !== '1');
// Same subset ranges as the app (src/renderer/fonts.ts).
const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT = 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const faces = `
@font-face { font-family: 'Instrument Sans'; src: url(${sans}) format('woff2'); font-weight: 400 700; font-display: swap; unicode-range: ${LATIN}; }
@font-face { font-family: 'Instrument Sans'; src: url(${sansExt}) format('woff2'); font-weight: 400 700; font-display: swap; unicode-range: ${LATIN_EXT}; }
@font-face { font-family: 'JetBrains Mono'; src: url(${mono}) format('woff2'); font-weight: 100 800; font-display: swap; unicode-range: ${LATIN}; }
@font-face { font-family: 'JetBrains Mono'; src: url(${monoExt}) format('woff2'); font-weight: 100 800; font-display: swap; unicode-range: ${LATIN_EXT}; }`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* First in the head, ahead of the stylesheets: what must run before anything paints (the home's old anchors). */}
    <slot name="head" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={mark} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={config.themeColor} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Atelier" />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Atelier: run many Claude Code sessions, never lose track" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLdScript(jsonLd)} />}
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <style set:html={faces}></style>
    {beacon && <Fragment set:html={beacon} />}
  </head>
  <body>
    <Nav />
    <main><slot /></main>
    <Footer />
    <SupportToast />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
