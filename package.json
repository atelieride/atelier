{
  "name": "atelier",
  "productName": "Atelier",
  "version": "0.2.0-beta.28",
  "description": "IDE for working with many Claude Code sessions in parallel",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/build-pty-host.mjs && node scripts/build-bridge.mjs && electron-vite build",
    "build:pty-host": "node scripts/build-pty-host.mjs",
    "build:bridge": "node scripts/build-bridge.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e-affected.mjs --all",
    "e2e:affected": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e-affected.mjs",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "build:whisper": "node scripts/build-whisper.mjs",
    "dist:unsigned": "npm run build && npm run build:whisper && electron-builder --config electron-builder.yml",
    "dist": "npm run dist:unsigned && node scripts/sign-app.mjs --auto release/mac-arm64/Atelier.app",
    "update-app": "npm run dist && playwright test --config playwright.manual.config.ts tests/e2e/packaged.manual.ts && node scripts/update-app.mjs",
    "stage-update": "npm run dist && playwright test --config playwright.manual.config.ts tests/e2e/packaged.manual.ts && node scripts/update-app.mjs --stage",
    "release": "node scripts/release.mjs",
    "site:shots": "npm run build && playwright test --config playwright.manual.config.ts tests/e2e/site-shots.manual.ts"
  },
  "dependencies": {
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "node-pty": "1.1.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.2.18",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "diff": "9.0.0",
    "electron": "44.10.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "hast-util-raw": "9.1.0",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-jsx-runtime": "2.3.6",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-hast": "13.2.1",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.5.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "zustand": "5.0.15"
  },
  "author": "Francesco Musso",
  "license": "MIT",
  "overrides": {
    "mdast-util-to-markdown": "2.1.3",
    "mdast-util-find-and-replace": "3.0.2"
  }
}
